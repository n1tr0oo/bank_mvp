# Скопируйте в .env и заполните перед запуском.
# .env находится в .gitignore — никогда не коммитим реальные секреты.

# === Postgres (используется docker-compose) ===
POSTGRES_USER=bank_app
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=bank_mvp

# === FastAPI app ===
# При локальном запуске без Docker DATABASE_URL должен указывать на ваш Postgres.
DATABASE_URL=postgresql+psycopg2://bank_app:replace_with_strong_password@localhost:5432/bank_mvp

# Минимум 32 байта энтропии. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_WITH__python_-c_"import_secrets;print(secrets.token_hex(32))"

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Production: ENABLE_DOCS=false (скрывает /docs и /redoc).
# Dev:        ENABLE_DOCS=true.
ENABLE_DOCS=false

# Лимит размера тела HTTP-запроса в байтах (CWE-770). 1 МБ по умолчанию.
MAX_BODY_BYTES=1048576

# Список IP/CIDR доверенных reverse-proxy через запятую (CWE-348).
# Пусто = X-Forwarded-For НЕ доверяем, IP берём из request.client.host.
TRUSTED_PROXIES=

# Порт хоста для UI (внутри контейнера всегда 8000).
APP_PORT=8000
